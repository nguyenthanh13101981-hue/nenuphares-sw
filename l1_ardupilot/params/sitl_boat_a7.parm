# Tham so SITL khung Boat theo Bang A.7 (CdCT Final 2.0 - L1 Pixhawk 6C / ArduPilot Rover 4.7.3)
# Khung thuyen, 50 Hz, khong dung compass, dinh huong GNSS 2 ang-ten,
# failsafe pin/GCS/geofence co hanh dong that, EKF source 2 VIO ODOMETRY,
# Lua scripting (M1-M4, loc gioi han dong 70/40 A, go rong <= 3 chu ky, watchdog Pi 5, khoa phep qua cau).

FRAME_CLASS 2
SCHED_LOOP_RATE 50

# Failsafe Rover 4.7.3 (A.7 / A.10): co hanh dong cu the (2 = Hold, 1 = RTL)
FS_TIMEOUT 3.0
FS_ACTION 2
FS_GCS_ENABLE 1
FS_GCS_TIMEOUT 5

# Giam sat pin bang shunt (Analog Voltage & Current = 4) + hanh dong failsafe
BATT_MONITOR 4
BATT_LOW_VOLT 12.2
BATT_FS_LOW_ACT 1
BATT_CRT_VOLT 11.5
BATT_FS_CRT_ACT 2

# Geofence hanh lang & vung cau -> Hold (2); tren thuc dia bat them polygon (FENCE_TYPE 6)
FENCE_ENABLE 1
FENCE_TYPE 2
FENCE_RADIUS 300
FENCE_ACTION 2

# Cam la ban tu (Luat cung #2): lay huong tu GNSS 2 ang-ten
# Tren phan cung that (HIL): cau hinh GPS1_TYPE=17 / GPS2_TYPE=18 (moving baseline) & GPS1_POS / GPS2_POS
COMPASS_USE 0
COMPASS_USE2 0
COMPASS_USE3 0
SIM_GPS1_ENABLE 1
SIM_GPS1_HDG 1
EK3_SRC1_POSXY 3
EK3_SRC1_VELXY 3
EK3_SRC1_YAW 2

# Nguon EKF thu 2: VIO ODOMETRY (ExternalNav = 6) khi mat GNSS duoi cau
VISO_TYPE 1
EK3_SRC2_POSXY 6
EK3_SRC2_VELXY 6
EK3_SRC2_YAW 6

# Nhieu gio va dong chay 0.10 m/s tren SITL
SIM_TIDE_SPEED 0.10
SIM_TIDE_DIR 90
SIM_WIND_SPD 0.10

# Bat Lua scripting & mapping 3 ESC AM32 (Trai=94, Phai=95, Du phong duoi=96)
SCR_ENABLE 1
SCR_HEAP_SIZE 131072
SERVO1_FUNCTION 94
SERVO2_FUNCTION 95
SERVO3_FUNCTION 96
